# NODE_ENV is the environment to run the application in
NODE_ENV=""

# Deployed application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Spotify API
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_USER_ID=""
SPOTIFY_REDIRECT_URI=""

# Github API
GITHUB_TOKEN=""

# Logo.dev API
NEXT_PUBLIC_LOGO_DEV_TOKEN=""

# Chat model: provider:model_name (see docs/chatbot.md)
AI_MODEL="anthropic:claude-haiku-5-5"

# Set ONLY the key for the selected provider; leave unused keys unset.
# Use a dedicated portfolio workspace with a spending limit.
# ANTHROPIC_API_KEY="sk-ant-..."
# GROQ_API_KEY="gsk_..."
# OPENAI_API_KEY="sk-..."

# Resend API
RESEND_API_KEY=""
